{
  "expo": {
    "name": "Conflict Connect",
    "slug": "conflict-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/conflict-connect-logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/conflict-connect-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFE8D6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.conflictconnect.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "jsEngine": "hermes"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/conflict-connect-logo.png",
        "backgroundColor": "#FFE8D6"
      },
      "package": "com.conflictconnect.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/conflict-connect-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-image-picker",
      "expo-document-picker",
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "tagline": "Conflict Connect: Mutual Aid & Resource Matching",
      "eas": {
        "projectId": "e9d7f471-fc50-48d9-8802-868a287ab658"
      }
    },
    "owner": "samcat"
  }
}
